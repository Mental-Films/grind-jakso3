// GRIND jakso 3 "Pelkääjän paikka" — teema
//
// Kaikki propin värit ja kirjasimet. Muokkaa tätä tekstieditorissa ja päivitä
// sivu — mitään ei tarvitse kääntää. Kommentit ovat sallittuja.
//
// Kamerasäännöt, jotka eivät ole makuasioita:
//   · kirkkain sallittu #C8D0D8 — #FFFFFF palaa puhki
//   · tummin sallittu #0E1116 — täysmusta ei valaise kasvoja
//   · vältä täyskylläisiä värejä, ne clippaavat ennen kirkkausrajaa
//
// Testaa muutokset avaamalla proppi lisäyksellä ?esikatselu — ja
// kameratestikortti näkyy viimeisessä cuessa (näppäin T).

{
  "varit": {
    "pohja":     "#0E1116",   // taustan pohja
    "paneeli":   "#151A21",
    "paneeli-2": "#1A2029",   // korostettu
    "paneeli-3": "#202834",   // kohotettu
    "viiva":     "#232B36",
    "viiva-2":   "#2E3846",
    "teksti":    "#C8D0D8",   // kirkkain sallittu
    "himmea":    "#6C7885",
    "himmea-2":  "#4E5866",
    "virhe":     "#C4402F",   // erääntynyt, lasku, reittiviiva
    "varoitus":  "#C79A3A",
    "ok":        "#5E9E6B",   // nousu

    // Rydez (puhelin) — graafikon liikevideon ilme. Poikkeaa tabletin
    // sovelluksista: kortit ovat VAALEITA mustalla tekstillä, aksentit
    // keltainen ja oranssi.
    "rydez-kortti":   "#F4F2ED",
    "rydez-musta":    "#141414",
    "rydez-harmaa":   "#6A675F",
    "rydez-keltainen":"#FFD60A",
    "rydez-oranssi":  "#FF5400",
    "rydez-punainen": "#E5342A"
  },

  // Hohtokerros — kohtauksen käytännön valo Alvinan kasvoille.
  //   keskus/reuna  = säteittäinen liuku, kun käyttöliittymä näkyy
  //   taysi         = puhdas hohto (⇧P / ⇧V), pelkkä valo ilman käyttöliittymää
  //   katto         = suurin peittävyys, jottei kuva pala puhki
  "hohto": {
    "punainen": {
      "keskus": "rgba(196,64,47,.95)",
      "reuna":  "rgba(120,26,20,.55)",
      "taysi":  "#B8382A",
      "katto":  0.85
    },
    "vihrea": {
      "keskus": "rgba(94,158,107,.95)",
      "reuna":  "rgba(30,84,46,.55)",
      "taysi":  "#4E9463",
      "katto":  0.85
    }
  },

  // Kartta. Yönavigaattorin paletti — maa tummin, tiet vaaleampia, reitti
  // punainen. Tiet piirretään kahdessa kerroksessa (kuori + täyttö), mikä
  // saa tiestön lukemaan karttana eikä viivapiirroksena.
  //
  // Nämä eivät ole CSS-muuttujia vaan menevät suoraan canvakselle, joten
  // rgba() käy mutta var() ei.
  "kartta": {
    // Rydez-kartta graafikon liikevideosta (Rydez-app-motion.mp4):
    // tumma neutraali pohja, vaaleanharmaat tiet ilman reunuksia,
    // kelta-oranssi paksu reitti ja oranssi autosprite.
    "maa":           "#2E2E2E",
    "kortteli":      "#3E3E3E",
    "metsa":         "#2A2E2A",
    "vesi":          "#26292E",
    "tie-kuori":     "#2E2E2E",   // ei erottuvaa reunusta — videon tiet ovat tasaisia
    "tie-paa":       "#8F8F8F",
    "tie":           "#6E6E6E",
    "tie-pieni":     "#4A4A4A",
    "kadunnimi":     "#A5A5A5",
    "tolppa":        "#FFD60A",   // taksitolpan merkki — Rydezin keltainen

    // Reitti kahtena kerroksena: keltainen ydin oranssin reunuksen päällä.
    // kartta.js piirtää kuoren leveämpänä ytimen alle, joten tämä vastaa
    // suoraan videon ilmettä.
    "reitti":        "#FFD60A",
    "reitti-kuori":  "#FF5400",
    "reitti-ajettu": "#7A5A08",
    "reitti-leveys": 15,

    "auto":          "#FF5000",
    "auto-hehku":    "rgba(255,84,0,.35)",

    // Signaali kadonnut: kartta himmenee lähes tyhjäksi ja jäljelle jää
    // sykkivä sijaintipiste (purku 6b).
    "signaali-himmennys": 0.1,
    "signaali-piste":     "#4A8FD8"
  },


  // ══ MITAT ═════════════════════════════════════════════════════════════
  // Nämä ovat ulkoasun rakennuspalikat. Jos graafikko toimittaa uuden
  // ilmeen — esimerkiksi Figma-sivuna — se ajetaan sisään TÄSTÄ, ei
  // CSS-tiedostoja muokkaamalla. Sovellukset käyttävät vain näitä nimiä.
  //
  // Sääntö: jos jokin luku toistuu kahdessa paikassa, sen kuuluu olla täällä.
  "mitat": {
    "kaarre-s":       "11px",   // pienet napit, tunnusluvut
    "kaarre-m":       "14px",   // paneelit, kortit
    "kaarre-l":       "18px",   // isot kortit
    "kaarre-xl":      "22px",   // arkit ja modaalit
    "kaarre-pilleri": "999px",

    "vali-xs":  "6px",
    "vali-s":   "10px",
    "vali-m":   "14px",
    "vali-l":   "18px",
    "vali-xl":  "26px",         // näytön sivumarginaali tabletilla

    "reuna":       "1px",
    "reuna-paksu": "2px",       // ohuin kameralle turvallinen viiva
    "kosketus":    "44px"       // pienin kosketusalue
  },

  // ══ TYPOGRAFIA ════════════════════════════════════════════════════════
  // Luettavuusportaat koodissa. Älä kirjoita pistekokoja suoraan CSS:ään —
  // koko ilme vaihdetaan täältä.
  "typografia": {
    "jatti":   "58px",   // lähikuvan yksittäinen luku
    "iso":     "46px",   // kurssi
    "suuri":   "34px",   // kate, laajan kuvan luku
    "otsikko": "19px",
    "vali":    "17px",
    "leipa":   "15px",
    "pieni":   "13px",
    "mikro":   "10.5px"  // versaaliotsikot
  },

  // ══ VARJOT ════════════════════════════════════════════════════════════
  // Kelluvat kerrokset erottuvat sisällöstä varjolla. Pidä ne pehmeinä:
  // terävä varjo lukee kameralle reunaviivana.
  "varjot": {
    "kelluva":  "0 10px 34px rgba(0,0,0,.55)",
    "paneeli":  "0 -6px 30px rgba(0,0,0,.55)",
    "arkki":    "0 -12px 44px rgba(0,0,0,.7)"
  },

  // Kirjasimet. IBM Plex on SIL OFL -lisensoitu, joten sen saa upottaa
  // levitykseen menevään tuotantoon. Pudota woff2-tiedostot kansioon
  // assets/fontit/ — ilman niitä käytetään laitteen omaa kirjasinta, mikä
  // kelpaa kameratestiin mutta ei lopulliseen proppiin.
  "fontit": {
    "teksti": "\"Plex\", -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
    "numero": "\"PlexMono\", ui-monospace, \"SF Mono\", Menlo, monospace"
  }
}
